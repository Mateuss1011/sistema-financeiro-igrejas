# =============================================================================
# SFG — modelo de configuração do backend.
#
# Este arquivo NÃO contém segredos e nunca deve conter: copie para `.env`, gere a chave (`php artisan key:generate`)
# e preencha os valores reais só no `.env`, que NÃO é versionado (está no .gitignore) e nunca vai para o repositório.
#
# Os padrões abaixo são os de PRODUÇÃO (seguros por padrão). Para desenvolvimento local, sobrescreva no seu `.env`
# com os valores do bloco "DESENVOLVIMENTO LOCAL" no fim do arquivo.
# =============================================================================

APP_NAME=SFG
APP_ENV=production
# Gerada por `php artisan key:generate`. Nunca compartilhe nem versione.
APP_KEY=
# Em produção DEVE ser false: com true, uma falha exporia stack traces e caminhos do servidor.
APP_DEBUG=false
# URL pública da API, obrigatoriamente https em produção.
APP_URL=https://api.exemplo.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Custo do bcrypt para as senhas. Não baixe de 12 em produção.
BCRYPT_ROUNDS=12

# Logs técnicos (storage/logs) — separados da auditoria de negócio (tabela audit_logs).
# `daily` gira o arquivo por dia e mantém LOG_DAILY_DAYS dias (com `single` o arquivo cresce sem limite).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB/MySQL. Em produção use o usuário RESTRITO da aplicação criado por docs/deploy/mariadb-privilegios.sql
# (sem UPDATE/DELETE em audit_logs, sem DDL) — nunca root. As migrations rodam com OUTRO usuário (migrador), informado
# só na hora do deploy: DB_USERNAME=... DB_PASSWORD=... php artisan migrate --force
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sfg
DB_USERNAME=
DB_PASSWORD=

# Sessão por cookie (Laravel Sanctum, SPA). Em produção o cookie só trafega por HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Domínio-PAI do cookie, com ponto inicial: o frontend (app.) e a API (api.) são subdomínios do mesmo domínio, e o
# frontend precisa ler o cookie XSRF-TOKEN que a API define. Sem isto o CSRF falha em produção.
SESSION_DOMAIN=.exemplo.org
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Host(s) do frontend que recebem sessão por cookie (separados por vírgula, sem esquema).
SANCTUM_STATEFUL_DOMAINS=app.exemplo.org
# Origem(ns) HTTPS do frontend liberadas no CORS (separadas por vírgula). Nunca use '*'.
CORS_ALLOWED_ORIGINS=https://app.exemplo.org
# Proxy reverso à frente da API (IPs/CIDRs separados por vírgula). Necessário para o Laravel reconhecer o HTTPS terminado
# no proxy; sem isso, o middleware de HTTPS redireciona em loop. Deixe VAZIO se a API recebe HTTPS direto. Nunca invente
# valores: use o IP real do proxy (docs/deploy/producao.md, seção "Proxy reverso").
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# =============================================================================
# DESENVOLVIMENTO LOCAL — valores para colocar no SEU `.env` (não neste modelo):
#   APP_ENV=local
#   APP_DEBUG=true
#   APP_URL=http://localhost:8000
#   LOG_LEVEL=debug
#   SESSION_ENCRYPT=false
#   SESSION_SECURE_COOKIE=false
#   SESSION_DOMAIN=localhost
#   LOG_STACK=single
#   SANCTUM_STATEFUL_DOMAINS=localhost:5173
#   CORS_ALLOWED_ORIGINS=http://localhost:5173
# =============================================================================
